{
  "pluginInfo": {
    "id": "postgres",
    "name": "PostgreSQL",
    "kind": "rdbms",
    "version": "0.1.0",
    "description": "Connect to PostgreSQL 12+ databases.",
    "config_schema": [
      {
        "key": "host",
        "label": "Host",
        "type": {
          "kind": "text"
        },
        "required": true,
        "default": "localhost",
        "placeholder": "localhost"
      },
      {
        "key": "port",
        "label": "Port",
        "type": {
          "kind": "number"
        },
        "required": true,
        "default": 5432,
        "placeholder": null
      },
      {
        "key": "database",
        "label": "Database",
        "type": {
          "kind": "text"
        },
        "required": true,
        "default": null,
        "placeholder": "postgres"
      },
      {
        "key": "user",
        "label": "User",
        "type": {
          "kind": "text"
        },
        "required": true,
        "default": null,
        "placeholder": "postgres"
      },
      {
        "key": "password",
        "label": "Password",
        "type": {
          "kind": "password"
        },
        "required": false,
        "default": null,
        "placeholder": null
      },
      {
        "key": "ssl",
        "label": "SSL",
        "type": {
          "kind": "select",
          "options": [
            "disable",
            "prefer",
            "require"
          ]
        },
        "required": false,
        "default": "prefer",
        "placeholder": null
      }
    ],
    "ui_module": "rdbms",
    "protocol_version": 1
  },
  "executable": "./rdb-plugin-postgres"
}
