{
  "pluginInfo": {
    "id": "mongodb",
    "name": "MongoDB",
    "kind": "document",
    "version": "0.1.0",
    "description": "Connect to MongoDB and Atlas clusters.",
    "config_schema": [
      {
        "key": "mode",
        "label": "Configure with",
        "type": {
          "kind": "select",
          "options": [
            "Connection string",
            "Individual settings"
          ]
        },
        "required": true,
        "default": "Connection string",
        "placeholder": null
      },
      {
        "key": "uri",
        "label": "Connection URI",
        "type": {
          "kind": "text"
        },
        "required": true,
        "default": "mongodb://localhost:27017",
        "placeholder": "mongodb://user:pass@host/db",
        "show_if": {
          "field": "mode",
          "equals": "Connection string"
        }
      },
      {
        "key": "host",
        "label": "Host",
        "type": {
          "kind": "text"
        },
        "required": true,
        "default": "localhost",
        "placeholder": "localhost or cluster.mongodb.net",
        "show_if": {
          "field": "mode",
          "equals": "Individual settings"
        }
      },
      {
        "key": "srv",
        "label": "Use SRV (Atlas / mongodb+srv)",
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "default": false,
        "placeholder": null,
        "show_if": {
          "field": "mode",
          "equals": "Individual settings"
        }
      },
      {
        "key": "port",
        "label": "Port",
        "type": {
          "kind": "number"
        },
        "required": false,
        "default": 27017,
        "placeholder": null,
        "show_if": {
          "field": "mode",
          "equals": "Individual settings"
        }
      },
      {
        "key": "user",
        "label": "User",
        "type": {
          "kind": "text"
        },
        "required": false,
        "default": null,
        "placeholder": null,
        "show_if": {
          "field": "mode",
          "equals": "Individual settings"
        }
      },
      {
        "key": "password",
        "label": "Password",
        "type": {
          "kind": "password"
        },
        "required": false,
        "default": null,
        "placeholder": null,
        "show_if": {
          "field": "mode",
          "equals": "Individual settings"
        }
      },
      {
        "key": "database",
        "label": "Default DB (optional)",
        "type": {
          "kind": "text"
        },
        "required": false,
        "default": null,
        "placeholder": null
      }
    ],
    "ui_module": "document",
    "protocol_version": 1
  },
  "executable": "./rdb-plugin-mongodb"
}
